# STS1000 "Meridian" application configuration
# SPDX-License-Identifier: Apache-2.0

mainmenu "STS1000 Meridian"

menu "STS1000 Meridian glue areas"

# The Zephyr glue layer (ARCHITECTURE.md §2 src/zephyr/) is split into four
# ownership areas. `platform` is unconditional — it owns bring-up, the timing
# engine glue, the 1 kHz scan and housekeeping, so there is no build without
# it. The other three are switchable so a bring-up image can be cut down to
# the timing path alone (useful for ADEV runs and for isolating a fault to an
# area). Each area's entry point has a __weak no-op fallback in
# src/zephyr/platform/sts_area_weak.c, so disabling one only removes its code.

config STS1000_NET
	bool "Network area (Ethernet, NTP/NTS, PTP, SNMP)"
	default y
	help
	  Builds src/zephyr/net/ and calls sts_net_start() from the bring-up
	  sequencer. Covers the RMII interface, DHCPv4/link management, the
	  NTP/NTS server, the PTP grandmaster and the SNMP agent.

config STS1000_CONSOLE
	bool "Console area (USB CDC-ACM, shell, MCP, storage)"
	default y
	help
	  Builds src/zephyr/console/ and calls sts_console_start() from the
	  bring-up sequencer. Covers the composite USB device, the Zephyr
	  shell on CDC-ACM #0, the binary Meridian Console Protocol channel on
	  CDC-ACM #1, settings/NVS persistence and the LittleFS mount.

config STS1000_UI
	bool "Local UI area (display, touch, encoder, panel)"
	default y
	help
	  Builds src/zephyr/ui/ and calls sts_ui_start() from the bring-up
	  sequencer. Covers the ST7796 TFT, the FT6336 touch controller, the
	  rotary encoder and the front-panel LEDs.

endmenu

menu "STS1000 Meridian bring-up"

config STS1000_NOR_RESET_RECOVERY_US
	int "SPI-NOR reset recovery time (us)"
	default 200
	range 10 100000
	help
	  Delay inserted after NOR_RST_N (PE10) is released before the
	  MX25L25645G is initialised (interface ref §2 Stage 2). Must cover the
	  device's tRHSL reset-recovery specification with margin.

config STS1000_PHY_RESET_ASSERT_US
	int "Ethernet PHY reset assertion width (us)"
	default 500
	range 100 100000
	help
	  How long LAN_RST_N (PD10) is held asserted. The LAN8742AI requires a
	  minimum 100 us reset pulse.

config STS1000_PHY_RESET_RECOVERY_US
	int "Ethernet PHY reset recovery time (us)"
	default 1000
	range 100 100000
	help
	  Delay after LAN_RST_N (PD10) is released before SMI/MDIO access is
	  permitted. The LAN8742AI specifies 100 us.

config STS1000_EARLY_RESET_INIT_PRIORITY
	int "Init priority of the early reset-release hook"
	default 45
	range 0 99
	help
	  POST_KERNEL priority of the hook that releases LAN_RST_N. It must run
	  before the MDIO, PHY and Ethernet drivers (default priorities 60, 70
	  and 80) or their probe finds the PHY held in reset.

endmenu

menu "STS1000 Meridian platform area"

# The clock-mux glue calls LL_RCC_GetSystemClocksFreq() to read the live SYSCLK
# across the HSI bridge. That is one of the few non-inline LL functions, so its
# source (stm32h5xx_ll_rcc.c) must be compiled — but USE_STM32_LL_RCC is a
# promptless symbol that can only be select-ed, and the STM32 clock driver
# selects it only on MP-series parts. Force it on here.
config STS1000_FORCE_LL_RCC
	bool
	default y
	select USE_STM32_LL_RCC

config STS1000_LOGRING_SLOTS
	int "Structured log ring depth (records)"
	default 192
	range 16 2048
	help
	  Records retained in the RAM log ring (core/logring). Each slot is
	  sizeof(logr_rec_t) — about 96 bytes with the default LOGR_MSG_MAX —
	  so 192 slots is roughly 18 KB. The ring is the source for MCP
	  LOG_TAIL and for the NOR spool; sizing it is a trade between how far
	  back a `log tail` can reach and SRAM.

config STS1000_RAM_STORE_ENTRIES
	int "RAM config store entries (pre-persistence)"
	default 48
	range 8 256
	help
	  Size of the volatile key/value store the platform gives core/cfg
	  before the console area registers the real NVS-backed one. It only
	  has to hold keys written during that window, which is why it is much
	  smaller than the full schema.

config STS1000_LIVENESS_DEADLINE_MS
	int "Liveness deadline (ms)"
	default 5000
	range 500 60000
	help
	  How long a registered liveness participant may go without feeding
	  before the supervisor stops kicking the external watchdog. Must be
	  comfortably longer than the slowest participant's period (the
	  housekeeping thread's 1 Hz sweep) and shorter than the TPS3430
	  timeout, so a genuinely wedged thread cold-cycles the board rather
	  than being tolerated.

config STS1000_WDT_KICK_WIDTH_US
	int "WDT_KICK pulse width (us)"
	default 50
	range 1 1000
	help
	  Width of the WDT_KICK (PB2) pulse presented to the TPS3430 WDI input.
	  Busy-waited, so keep it short. Must exceed the device's minimum
	  pulse-width specification.

config STS1000_CLKMUX_MAX_SETTLE_MS
	int "Maximum clock-mux settle time (ms)"
	default 20
	range 1 100
	help
	  Upper bound on the settle delay the reference state machine may
	  request during an OCXO<->Rb handoff. The whole handoff runs with
	  interrupts locked and SYSCLK bridged to HSI, so this value directly
	  bounds how long the system runs at the wrong clock. A larger settle
	  request from refsel is clamped to this and logged.

config STS1000_DIGIPOT_SPI_HZ
	int "MCP41U83 digipot SPI clock (Hz)"
	default 1000000
	range 100000 10000000
	help
	  SPI4 clock used for the rubidium-rail digipot (U43). The part is
	  rated well above this; the conservative default keeps the edge rates
	  down on a bus shared with a 40 MHz NOR and a display ribbon.

config STS1000_PANEL_LED_PWM_HZ
	int "Panel-LED PWM frequency (Hz)"
	default 1000
	range 200 20000
	help
	  LPTIM2_CH2 (PE0) carrier for the front-panel LED string. Must be far
	  above the flicker threshold and far above the reciprocal of the
	  INA228 0x4C averaging window, or the panel current reading beats
	  against the duty cycle (interface ref §4.1).

endmenu

module = STS1000
module-str = sts1000
source "subsys/logging/Kconfig.template.log_config"

source "Kconfig.zephyr"
