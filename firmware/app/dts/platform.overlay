/*
 * STS1000 "Meridian" — platform-area devicetree overlay.
 *
 * SPDX-License-Identifier: Apache-2.0
 *
 * Merged after the board .dts by app/CMakeLists.txt. Carries only what the
 * platform area adds on top of the board definition; the net, console and ui
 * areas own dts/net.overlay, dts/console.overlay and dts/ui.overlay.
 */

/*
 * LPTIM2 drives PANEL_LED_PWM on PE0 (LPTIM2_CH2, AF3 — verified against the
 * STM32H563 alternate-function table, see src/zephyr/platform/panel_pwm.c).
 *
 * The node is enabled but no Zephyr driver binds it: `st,stm32-lptim` is only
 * claimed by the LPTIM kernel-tick driver, which is not in use here (SysTick
 * is the tick source). Enabling it makes the DT_ macros — reg, clocks —
 * available so the platform can gate the clock and select the source itself.
 *
 * pinctrl-0 is deliberately NOT set here: the `st,stm32-lptim` binding does not
 * declare a pinctrl property (dtc rejects it), so the PE0->AF3 mux is applied
 * from panel_pwm.c with LL_GPIO instead. The pin assignment is still recorded
 * in devicetree as the lptim2_ch2_pe0 group in the board pinctrl overlay.
 *
 * The second clocks entry pins the kernel clock to PCLK1 rather than relying
 * on the RCC_CCIPR2 reset default, so the /128 prescaler and the ARR the
 * platform computes are derived from a source the devicetree states.
 */
&lptim2 {
	clocks = <&rcc STM32_CLOCK(APB1_2, 5U)>,
		 <&rcc STM32_SRC_PCLK1 LPTIM2_SEL(0)>;
	status = "okay";
};

/*
 * PANEL_LED_PWM is now a peripheral output, not a GPIO. Drop the stale
 * /zephyr,user handle so nothing can claim the pin as a plain output behind
 * the LPTIM's back — the board .dts declared it that way when the AF was
 * believed not to exist.
 */
&zephyr_user {
	/delete-property/ panel-led-pwm-gpios;
};

/*
 * STM32 internal die-temperature sensor (ADC1 internal channel 16, factory
 * cal). It is the tertiary input to the thermal over-temp ladder: when the
 * enclosure TMP117 (0x48) fails, the ladder falls back to the oscillator
 * TMP117 (0x49) and then to this (ARCHITECTURE.md §10.2, thermal Wave-2b
 * contract). Disabled in the SoC dtsi; the housekeeping thread reads it via
 * the sensor API and degrades to die_valid=false if it is not ready, so the
 * ladder still has the two TMP117s.
 */
&die_temp {
	status = "okay";
};
