{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "fable",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(./secrets/**)",
      "Read(./config/credentials.json)",
      "Read(~/.aws/credentials)",
      "Read(~/.aws/config)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.pfx)"
    ],
    "ask": [
      "Bash(aws:*)",
      "Bash(sam:*)",
      "Bash(cdk:*)",
      "Bash(terraform:*)",
      "Bash(pulumi:*)"
    ],
    "allow": [
      "Bash(aws sts get-caller-identity:*)",
      "Bash(aws configure list:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  }
}
